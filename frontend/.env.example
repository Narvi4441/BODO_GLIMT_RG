# Cliente: URL base sin /api. Vacío = mismo origen mediante proxy de Vite.
# Producción: HTTPS para API y WSS para WebSocket, o proxy del mismo origen.
VITE_API_URL=
VITE_WS_URL=/ws
# Solo servidor de desarrollo/preview. No se incluye en el bundle del cliente.
API_PROXY_TARGET=http://127.0.0.1:8000
# HTTPS local: certificado confiable en el PC Y en el teléfono, válido para la IP LAN.
# DEV_HTTPS_CERT=certs/guardian.pem
# DEV_HTTPS_KEY=certs/guardian-key.pem
