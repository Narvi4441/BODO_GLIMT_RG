# Copiar a backend/.env y completar. No subir .env al repositorio.
# Codifica caracteres especiales de usuario/contraseña para una URL (ejemplo: @ = %40).
DATABASE_URL=postgresql+psycopg2://USUARIO:CONTRASENA@localhost:5432/persistencia
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
# Índice C5 existente y metadata meta:camara:{id}; independiente de journeys.
C5_REDIS_URL=redis://localhost:6379/5
TELEMETRY_OFFLINE_TIMEOUT_SECONDS=15
GOOGLE_API_KEY=
# Configurar el secreto solo en Railway: valor aleatorio de al menos 32 bytes.
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
# Origenes de la PWA separados por comas; agrega tu dominio HTTPS si usas API separada.
CORS_ORIGINS=https://bodo-glimt-rg.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
